# Banco do docker-compose.yml. Caracteres especiais na senha precisam ser codificados: "#" vira %23.
DATABASE_URL="postgresql://gotago:Gota2026Go%23@localhost:5432/gotago_db"

# Chave secreta usada para assinar os tokens JWT. Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-um-texto-longo-e-aleatorio"

# Origens permitidas pelo CORS, separadas por vírgula. Vazio = libera todas (só em desenvolvimento).
CORS_ORIGIN=

# Porta da API (padrão 3333)
PORT=3333

# Fuso que define quando um dia começa (metas e sequências). Importante em servidores em UTC.
TZ=America/Sao_Paulo

# Endereço público da API, usado no link de recuperação de senha
APP_URL=http://localhost:3333

# "true" apenas se houver um proxy reverso na frente da API
TRUST_PROXY=false

# "true" mostra cada consulta SQL no terminal
PRISMA_LOG_QUERIES=false

# Só para o Docker: troque se a porta 5432 já estiver em uso
# POSTGRES_PORT=5432
