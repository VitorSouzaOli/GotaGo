{
  "name": "gotago",
  "version": "1.0.0",
  "description": "GotaGo Water Tracking API",
  "main": "src/server.ts",
  "type": "module",
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.5",
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "prisma": "5.22.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.1.1"
  }
}
